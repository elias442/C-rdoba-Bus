# Servidor
PORT=8787
HOST=0.0.0.0

# Micronauta / Tu Bondi. No hace falta una clave: la sesión se abre sola.
MICRONAUTA_BASE_URL=https://micronauta4.dnsalias.net
MICRONAUTA_CONF=cbaciudad
UPSTREAM_TIMEOUT_MS=20000
SESSION_TTL_MS=600000
PROVIDER_COOLDOWN_MS=90000

# Caché en memoria. El GPS se comparte entre visitantes del mismo recorrido.
CACHE_LINES_TTL_MS=600000
CACHE_TRACE_TTL_MS=1800000
CACHE_VEHICLES_TTL_MS=12000

# Frontend. Vite solo lee variables VITE_ desde frontend/.env.
# Si no están definidas, la app usa estos mismos valores por defecto.
VITE_API_BASE_URL=/api
VITE_MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
VITE_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark
# Tu Bondi consulta el GPS cada 15 s. No bajar de 8 s.
VITE_VEHICLE_POLL_MS=15000
